msgstr "Änderungsprotokoll"

msgid "Documentation"
msgstr "Dokumentation"

msgid "Plugin website"
msgstr "Plugin-Website"

msgid "Donate"
msgstr "Spenden"

msgid "Join our Newsletter"
msgstr "Newsletter abonnieren"

